{
  "name": "huy-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "format": "prettier --write src scripts docs *.ts *.json *.mjs *.md",
    "test:intro": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:motion": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:redesign": "node scripts/verify-redesign.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
